# Copy this file to .env and fill it in.

# The port your friends connect to. Forward this TCP port on your router to the Docker machine.
# 443 is the least suspicious; pick another only if 443 is taken.
VPN_PORT=443

# Your public IP address or (better) a dynamic DNS name like myname.duckdns.org.
# Goes into every key. You can also set it later in the console (Server settings).
PUBLIC_HOST=

# Console password (at least 8 characters). Leave empty to get a random one in "docker compose logs".
ADMIN_PASSWORD=

# Console port on this machine, and which address it listens on (127.0.0.1 = this machine only).
CONSOLE_PORT=8088
CONSOLE_BIND=0.0.0.0
